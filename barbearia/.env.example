# Configurações do Django
DJANGO_SETTINGS_MODULE=configuracao.settings.dev
DJANGO_SECRET_KEY=altere-para-uma-chave-secreta-segura-e-unica-em-producao
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,seu-dominio.com

# Banco de dados SQLite
SQLITE_TIMEOUT=20
SQLITE_ENABLE_WAL=True

# Parâmetros de segurança e rate limit de login do barbeiro / proprietário
RATE_LIMIT_LOGIN_MAX_TENTATIVAS=30
RATE_LIMIT_LOGIN_JANELA_MINUTOS=10
RATE_LIMIT_LOGIN_BLOQUEIO_MINUTOS=30

# Segurança de rede / Proxy
# Lista de IPs de proxies confiáveis separados por vírgula (ex: 127.0.0.1,10.0.0.1)
# Deixe vazio se a aplicação receber conexões diretas do cliente
TRUSTED_PROXY_IPS=
